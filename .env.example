# Database
DATABASE_URL="postgresql://user:password@localhost:5432/myglowback"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth (optional sign-in method)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Paystack (test mode keys from your Paystack dashboard)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxx"

# Email (Resend or SMTP via Nodemailer)
EMAIL_SERVER_HOST="smtp.resend.com"
EMAIL_SERVER_PORT="465"
EMAIL_SERVER_USER="resend"
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="MyGlowBack.AI <hello@myglowback.ai>"

# Cron protection - Vercel Cron sends this header automatically when set
CRON_SECRET="generate-a-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
