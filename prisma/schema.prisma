// MyGlowBack.AI — Prisma schema
//
// This follows the spec exactly, with two small additions required for the
// schema to actually validate (Prisma needs both sides of every relation
// declared, the original spec only listed one side for a few of them):
//   1. Assessment gets a clinicId/clinic relation (Clinic.assessments needed it)
//   2. Location, User, and Patient get back-relation arrays for Appointment
// Everything else — models, fields, enums, cascade behavior — is as specified.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Clinic {
  id                String         @id @default(cuid())
  name              String
  email             String         @unique
  phone             String?
  address           String?
  logoUrl           String?
  billingCycle      BillingCycle   @default(ANNUAL)
  subscriptionStart DateTime
  subscriptionEnd   DateTime
  isActive          Boolean        @default(true)
  isTrialing        Boolean        @default(true)
  // Prescription-tier gate: unverified by default. A clinic can claim
  // PHARMACY at signup, but licenseVerifiedAt stays null — and therefore
  // pharmacy-only content stays locked — until a SUPER_ADMIN manually checks
  // the license number and sets it. Self-declaration alone never unlocks it.
  licenseType                ClinicLicenseType @default(AESTHETIC_OR_MERCHANT)
  professionalLicenseNumber  String?
  licenseVerifiedAt          DateTime?
  licenseVerifiedByEmail     String?
  locations         Location[]
  staff             User[]
  patients          Patient[]
  products          Product[]
  invoices          Invoice[]
  assessments       Assessment[]
  notifications     Notification[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

enum ClinicLicenseType {
  PHARMACY             // PCN-licensed pharmacy — can unlock prescription-tier escalation content once verified
  AESTHETIC_OR_MERCHANT // Medspa, aesthetician, or general cosmetics merchant — no equivalent licensing body in Nigeria yet, so this tier never sees prescription-tier content, verified or not
}

enum BillingCycle {
  ANNUAL
  MONTHLY
}

model Location {
  id           String        @id @default(cuid())
  name         String
  address      String
  phone        String?
  clinicId     String
  clinic       Clinic        @relation(fields: [clinicId], references: [id])
  appointments Appointment[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  password     String?
  role         Role          @default(STAFF)
  clinicId     String?
  clinic       Clinic?       @relation(fields: [clinicId], references: [id])
  assessments  Assessment[]
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum Role {
  SUPER_ADMIN
  CLINIC_ADMIN
  STAFF
}

model Patient {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String
  dateOfBirth   DateTime?
  biologicalSex BiologicalSex? // Determines whether pregnancy/hormonal-stage questions are shown at all — never used to gate care itself
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id])
  assessments   Assessment[]
  appointments  Appointment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum BiologicalSex {
  FEMALE
  MALE
  INTERSEX_OR_OTHER
  UNDISCLOSED
}

model Assessment {
  id                      String    @id @default(cuid())
  patientId               String
  patient                 Patient   @relation(fields: [patientId], references: [id])
  staffId                 String
  staff                   User      @relation(fields: [staffId], references: [id])
  clinicId                String
  clinic                  Clinic    @relation(fields: [clinicId], references: [id])
  skinType                SkinType  // Base type, determined from the objective behavior-based
                                     // questions in the assessment doc — never a raw self-label
  sensitiveOverlay        Boolean   @default(false) // Reactivity is its own axis, independent of
                                     // skinType above — an OILY patient can also flag as reactive
  fitzpatrickType         FitzpatrickType?
  concerns                Concern[] // STRICTLY LIMITED TO: ACNE, HYPERPIGMENTATION, SUN_DAMAGE,
                                     // AGING, GLOWING_SKIN
  severityByConcern       Json?     // e.g. { "ACNE": "MODERATE", "HYPERPIGMENTATION": "MILD" } —
                                     // keys are Concern values, values are SeverityLevel values
  allergies               String?
  knownSkinConditions     String?   // free text: doctor-diagnosed eczema, rosacea, psoriasis, etc.
  currentMedications      String?   // free text — avoids recommending something redundant/conflicting
  previousTreatments      String?   // free text — avoids re-recommending something already tried
  goals                   String?
  ageRange                AgeRange?
  // --- Hard-safety fields: read directly by the matching engine's blocking
  // logic (see matching-engine.ts) before anything else is scored. ---
  pregnancyStatus         PregnancyStatus @default(NOT_APPLICABLE)
  hormonalStage           HormonalStage   @default(NOT_APPLICABLE)
  onHormonalContraceptionOrHRT Boolean    @default(false)
  cycleRelatedFlares      Boolean   @default(false)
  hotFlashesOrNightSweats Boolean   @default(false)
  recentSkinTextureChange Boolean   @default(false)
  recommendedRoutine      Json?
  recommendedIngredients  String[]
  matchedProducts         String[]
  suggestedUpsells        String[]
  safetyBlockedIngredients String[] @default([]) // Set by the engine — transparency record of what
                                     // was excluded and why, visible to the dispensing pharmacist
  escalationNote          String?   // Set by the engine when a verified pharmacy's patient may
                                     // benefit from prescription-tier intervention — never an
                                     // instruction to dispense, always framed as "refer/prescribe"
  followUpDate            DateTime?
  createdAt               DateTime  @default(now())
}

enum SeverityLevel {
  MILD
  MODERATE
  SEVERE
}

enum PregnancyStatus {
  PREGNANT
  BREASTFEEDING
  TRYING_TO_CONCEIVE
  NONE
  NOT_APPLICABLE // e.g. male patients, or undisclosed — never assumed, always asked
}

enum HormonalStage {
  PUBERTY
  REPRODUCTIVE
  PERIMENOPAUSAL
  MENOPAUSAL
  POST_MENOPAUSAL
  NOT_APPLICABLE
}

enum FitzpatrickType {
  TYPE_I
  TYPE_II
  TYPE_III
  TYPE_IV
  TYPE_V
  TYPE_VI
}

enum SkinType {
  OILY
  DRY
  COMBINATION
  SENSITIVE
  NORMAL
}

enum Concern {
  ACNE
  HYPERPIGMENTATION
  SUN_DAMAGE
  AGING
  GLOWING_SKIN // General radiance/even-tone maintenance — not a "condition" with
               // severity tiers like the other 4; routine-complexity based instead
} // Hyper-focused on these 5 core concerns only

enum AgeRange {
  UNDER_18
  AGE_18_25
  AGE_26_35
  AGE_36_45
  AGE_46_55
  AGE_55_PLUS
}

model Product {
  id                String     @id @default(cuid())
  name              String
  brand             String?
  category          String
  price             Float?
  stockQuantity     Int        @default(0)
  activeIngredients String[]
  concerns          Concern[] // Matches the 5 core concerns
  isUpsell          Boolean    @default(false)
  clinicId          String
  clinic            Clinic     @relation(fields: [clinicId], references: [id])
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Appointment {
  id         String            @id @default(cuid())
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  locationId String
  location   Location          @relation(fields: [locationId], references: [id])
  staffId    String?
  staff      User?             @relation(fields: [staffId], references: [id])
  title      String
  date       DateTime
  duration   Int
  status     AppointmentStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  clinicId        String
  clinic          Clinic        @relation(fields: [clinicId], references: [id])
  amount          Float
  discountApplied Float         @default(0)
  totalDue        Float
  status          InvoiceStatus @default(UNPAID)
  dueDate         DateTime
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

model Notification {
  id              String   @id @default(cuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id])
  type            NotifType
  sentAt          DateTime
  daysUntilExpiry Int
  message         String
  link            String
  isSeen          Boolean  @default(false)
  createdAt       DateTime @default(now())
}

enum NotifType {
  DASHBOARD
  EMAIL
}

// Dummy rules — will be replaced by the real rule set (see MASTER_ALGORITHM.md & ASSESSMENT_QUESTIONNAIRE.md). Covers all 5 core concerns.
model SkincareRule {
  id                       String   @id @default(cuid())
  name                     String   @unique // lets the seed script safely replace rules on re-run
  condition                Json     // e.g. { concerns: ["ACNE"], skinType: ["OILY"], avoidIngredients: ["retinol"], severity: ["MODERATE","SEVERE"] }
  routine                  Json     // { am: ["Step 1..."], pm: ["Step 2..."] }
  ingredients              String[]
  upsells                  String[]
  followUpDays             Int      @default(30)
  requiresLicensedPharmacy Boolean  @default(false) // Only ever a candidate for a Clinic with
                           // licenseType PHARMACY and a non-null licenseVerifiedAt
  escalationNote           String?  // Shown alongside the routine when this rule fires — always
                           // framed as "refer to / requires a licensed prescriber," never a
                           // dispensing instruction the app is giving on its own
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}
